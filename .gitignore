# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Coverage
coverage/

# Student identity documents (Aadhaar, marksheets) — never commit these
uploads/

# Production database dumps — contain real user data (emails, bcrypt hashes, tokens).
# NB: the real dir is data/backup/ (singular). The old `backups/` line was a typo that let
# users.bson / submissions.bson / refreshtokens.bson get committed. Cover all forms.
backups/
data/backup/
**/backup/
*.bson
*.archive

# Python bytecode
__pycache__/
*.pyc

# Local dev credentials — never commit (contains demo passwords, connection strings)
CREDENTIALS.md

# Large local data snapshot (~68MB, incl. a 69MB allotments.json). Kept on disk, not in git —
# the DB already contains this data. Use Git LFS if it ever needs to be versioned.
/data/seed/

# Runtime JSON fallback store (auth/chat) — regenerated by the server, carries session tokens
server/data/db.json
