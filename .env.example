# ═══════════════════════════════════════════
# MedCounsel AI — Environment Variables
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
# Avoid 5000 on macOS — AirPlay Receiver binds it and answers 403 on every route.
PORT=5050
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/medcounsel_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MedCounsel AI <noreply@medcounsel.ai>"

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ── MedAssist AI (chatbot) ──────────────────────────────────────────────────
# The assistant talks to any OpenAI-compatible chat API. Leave AI_API_KEY blank to
# run the built-in keyless offline fallback (answers from the app's data only).
#
# Recommended — Groq (free): https://console.groq.com -> sign in -> "API Keys" ->
# "Create API Key", then paste the gsk_... value below. The base URL + model are
# already set for Groq. Restart the server after adding the key.
#
# Other providers work too — just change AI_API_BASE_URL + AI_MODEL:
#   OpenAI  https://api.openai.com/v1                                  (gpt-4o-mini)
#   Gemini  https://generativelanguage.googleapis.com/v1beta/openai/   (gemini-2.0-flash)
#   Ollama  http://localhost:11434/v1                                  (llama3.2) — no key needed
#
# NEVER commit a real key. This file ships placeholders only — put your real key in
# the git-ignored .env. A live key pushed to a public repo is scraped and auto-revoked.
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Seeding (npm run seed) requires a strong admin password — no default is baked in anymore.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# OTP Settings
OTP_EXPIRY_MINUTES=3
OTP_LENGTH=6
