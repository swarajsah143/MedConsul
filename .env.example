# ═══════════════════════════════════════════
# MedCounsel AI — Environment Variables
# ═══════════════════════════════════════════

# Server
NODE_ENV=development
# Avoid 5000 on macOS — AirPlay Receiver binds it and answers 403 on every route.
PORT=5050
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/medcounsel_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="MedCounsel AI <noreply@medcounsel.ai>"

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# AI API (OpenAI-compatible)
# AI assistant — OpenAI-compatible endpoint (leave blank to run the RAG-only fallback).
# NOTE: a real Resend email key was previously committed here by mistake — it has been revoked.
# Never paste a live secret into .env.example; use placeholders only.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Seeding (npm run seed) requires a strong admin password — no default is baked in anymore.
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=

# OTP Settings
OTP_EXPIRY_MINUTES=3
OTP_LENGTH=6
