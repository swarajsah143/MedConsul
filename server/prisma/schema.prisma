// Prisma Schema for MedCounsel AI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  phone         String    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  role          Role      @default(STUDENT)
  isVerified    Boolean   @default(false)
  avatar        String?
  neetScore     Int?
  neetRank      Int?
  category      String?
  state         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatSessions  ChatSession[]
  bookmarks     Bookmark[]
  savedFilters  SavedFilter[]

  @@map("users")
}

model OtpVerification {
  id        String     @id @default(uuid())
  email     String
  otp       String
  purpose   OtpPurpose
  expiresAt DateTime
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_verifications")
}

model College {
  id          String   @id @default(uuid())
  name        String
  state       String
  city        String
  type        String   // Government, Private, Deemed
  totalSeats  Int?
  website     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cutoffEntries    CutoffEntry[]
  allotmentResults AllotmentResult[]

  @@index([state, type])
  @@map("colleges")
}

model CutoffEntry {
  id          String   @id @default(uuid())
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  year        Int
  round       Int
  category    String   // General, OBC, SC, ST, EWS
  subcategory String?  // PWD, Defense, etc.
  quota       String   // AIQ, State, Management, NRI
  seatType    String?  // Government, Private, Management, etc.
  course      String   @default("MBBS")
  air         Int      // Closing All India Rank (AIR)
  score       Int?     // Closing NEET Score
  fees        Float?   // Tuition Fees
  createdAt   DateTime @default(now())

  // Keep for legacy compatibility
  openRank    Int?
  closeRank   Int?
  openScore   Float?
  closeScore  Float?

  @@index([collegeId, course, quota, category, round, air, score])
  @@index([year, course])
  @@map("cutoff_entries")
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json     // stores the filter params as a JSON object
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_filters")
}

model AllotmentResult {
  id          String   @id @default(uuid())
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  year        Int
  round       Int
  category    String
  quota       String
  course      String   @default("MBBS")
  seatsTotal  Int?
  seatsFilled Int?
  lastRank    Int?
  lastScore   Float?
  createdAt   DateTime @default(now())

  @@index([collegeId, year, round])
  @@map("allotment_results")
}

model StateRule {
  id          String   @id @default(uuid())
  state       String
  title       String
  description String   @db.Text
  category    String   // Eligibility, Domicile, Fee, Process
  year        Int
  isActive    Boolean  @default(true)
  sourceUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, category])
  @@map("state_rules")
}

model Document {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  state       String?  // null = all states
  category    String?  // null = all categories
  isRequired  Boolean  @default(true)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([state, category])
  @@map("documents")
}

// ─── Counseling Notifications Module ──────────────────────────
model CounselingNotification {
  id              String   @id @default(uuid())
  title           String
  summary         String   @db.Text
  content         String?  @db.Text       // full rich-text body
  translationHi   String?  @db.Text       // Hindi summary
  state           String                  // "All India", "Maharashtra", etc.
  category        String                  // "Schedule", "Seat Matrix", "Fee", "Document", "Result", "General"
  counselingBody  String                  // "MCC", "KEA", "CET Cell", "DGHS", etc.
  pdfUrl          String?                 // path to uploaded PDF
  pdfOriginalName String?                 // original filename
  sourceUrl       String?                 // external official link
  priority        String   @default("normal") // "urgent", "high", "normal", "low"
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookmarks       Bookmark[]

  @@index([state, category])
  @@index([counselingBody])
  @@index([publishedAt])
  @@map("counseling_notifications")
}

model Bookmark {
  id               String                @id @default(uuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId   String
  notification     CounselingNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  createdAt        DateTime              @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
  @@map("bookmarks")
}

// ─── Chat Module ──────────────────────────────────────────────
model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // user, assistant, system
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}
