{
  "name": "medcounsel-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test:integrity": "tsx src/test/integrity.test.ts",
    "test:documents": "tsx src/test/documents.test.ts",
    "test": "npm run test:integrity && npm run test:documents && npm run test:admin-users && npm run test:students && npm run test:profile",
    "test:admin-users": "tsx src/test/admin-users.test.ts",
    "test:students": "tsx src/test/students.test.ts",
    "test:profile": "tsx src/test/profile.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.4",
    "typescript": "~5.7.3"
  }
}
